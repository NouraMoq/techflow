# ============================================================================
# صانع المحتوى | Content Maker — Environment variables (EXAMPLE)
# NEVER commit real secrets. Copy to .env.local and fill values there.
# The current prototype (app/) needs NONE of these — they are for the
# proposed Next.js production build documented in docs/.
# ============================================================================

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
DEFAULT_LOCALE=ar

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/content_maker

# --- Auth (Auth.js) ---
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# --- Object Storage (S3-compatible) ---
S3_ENDPOINT=
S3_REGION=me-central-1
S3_BUCKET=content-maker-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Signed URLs only — never expose keys to the frontend.

# --- Queue / Background jobs (optional; Mock by default) ---
REDIS_URL=

# --- Integrations (all optional; Mock providers used until credentials exist) ---
# Never claim publish success before the official API confirms it.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# --- AI provider (server-side only) ---
AI_API_KEY=

# --- Payments (independent provider layer; connect a KSA gateway later) ---
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=

# --- Email / notifications (later phases) ---
SMTP_URL=
