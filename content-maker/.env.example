# Local dev: SQLite. Production: switch datasource provider to "postgresql".
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/content_maker"  # production
AUTH_SECRET="replace-with-a-long-random-string-min-32-chars"
NODE_ENV="development"

# --- TikTok integration (optional). Absent → Mock provider is used. ---
# Never claim publish success before the official API confirms it.
# TIKTOK_CLIENT_KEY=""
# TIKTOK_CLIENT_SECRET=""
# TIKTOK_REDIRECT_URI="http://localhost:3000/integrations/callback"

# --- Object storage (optional). Absent → Local disk provider (.storage/). ---
# S3_BUCKET=""
# S3_REGION="me-central-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""   # set for MinIO / S3-compatible (enables path-style)
