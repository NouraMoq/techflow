# Production environment (PostgreSQL). Copy to .env / set as real secrets.
# NEVER commit real values.
DATABASE_URL="postgresql://content_maker:CHANGE_ME@db:5432/content_maker"
# Generate a strong 32+ char secret, e.g.: openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_to_a_long_random_secret_min_32_chars"
NODE_ENV="production"
# Seed demo data on first container start (set false for real production).
SEED_ON_START="false"

# --- Optional integrations (absent → Mock provider) ---
